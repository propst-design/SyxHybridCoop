<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wrrr0.songsofsyx</groupId>
    <artifactId>syx-hybrid-coop</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>Syx Hybrid Co-Op Mod</name>
    <description>Shared-City Lockstep and Shared-World Multiplayer Mod for Songs of Syx (v0.71.44)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bytecode target matches Songs of Syx .classpath (JavaSE-1.8) while running on bundled Java 21 JRE -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <!-- Songs of Syx Version (from game/VERSION.java in SongsOfSyx-sources.jar) -->
        <game.version.major>71</game.version.major>
        <game.version.minor>44</game.version.minor>
        <mod.folder.name>SyxHybridCoop</mod.folder.name>
        <mod.jar.name>SyxHybridCoop</mod.jar.name>

        <!-- Local Machine Paths for wrrr0 -->
        <game.installation.directory>F:\SteamLibrary\steamapps\common\Songs of Syx</game.installation.directory>
        <game.mod.directory>%USERPROFILE%\AppData\Roaming\songsofsyx\mods</game.mod.directory>
        <game.mod.uploader.directory>%USERPROFILE%\AppData\Roaming\songsofsyx\mods-uploader</game.mod.uploader.directory>

        <!-- Staging path inside target/ -->
        <mod.staging.dir>${project.build.directory}/out/${mod.folder.name}</mod.staging.dir>
    </properties>

    <dependencies>
        <!-- Base Game Dependency (Registered into local .m2 via `mvn validate`) -->
        <dependency>
            <groupId>com.songsofsyx</groupId>
            <artifactId>songsofsyx</artifactId>
            <version>${game.version.major}.${game.version.minor}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 for Headless Packet, Lockstep, and Determinism Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${mod.jar.name}</finalName>
        <plugins>
            <!-- 1. Register SongsOfSyx.jar & SongsOfSyx-sources.jar from F:\SteamLibrary\... on `mvn validate` -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>install-songsofsyx-jar</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${game.installation.directory}\SongsOfSyx.jar</file>
                            <sources>${game.installation.directory}\info\SongsOfSyx-sources.jar</sources>
                            <groupId>com.songsofsyx</groupId>
                            <artifactId>songsofsyx</artifactId>
                            <version>${game.version.major}.${game.version.minor}</version>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Compile Java 1.8 compatible bytecode -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- 3. Run JUnit 5 Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- 4. Package Mod Folder Structure (_Info.txt + V71/script/SyxHybridCoop.jar) and Deploy on `mvn install` -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!-- Copy _Info.txt and any mod assets into target/out/SyxHybridCoop -->
                    <execution>
                        <id>stage-mod-files</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.staging.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/resources/mod-files</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Copy compiled SyxHybridCoop.jar into target/out/SyxHybridCoop/V71/script/ -->
                    <execution>
                        <id>stage-mod-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${mod.staging.dir}/V${game.version.major}/script</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${mod.jar.name}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Copy staged mod into %APPDATA%\songsofsyx\mods\SyxHybridCoop on `mvn install` -->
                    <execution>
                        <id>deploy-to-appdata-mods</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${game.mod.directory}/${mod.folder.name}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${mod.staging.dir}</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Optional profile (`mvn clean install -P mods-uploader`) to stage for Steam Workshop Uploader -->
        <profile>
            <id>mods-uploader</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>deploy-to-workshop-uploader</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${game.mod.uploader.directory}/${mod.folder.name}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${mod.staging.dir}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>include-source-for-workshop-transparency</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${game.mod.uploader.directory}/${mod.folder.name}/V${game.version.major}/script/_src</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/main/java</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
